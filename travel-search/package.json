{
  "name": "aijoes-travel-search",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AI Joe's travel search back end: three options that respect the non-negotiables, refined as often as you like, always savable and printable.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server.mjs",
    "start": "node dist/server.mjs",
    "e2e": "npm run build && node scripts/e2e.mjs"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "express": "^5.2.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.19.0",
    "@types/supertest": "^6.0.3",
    "esbuild": "^0.28.2",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.2",
    "vitest": "^3.2.7"
  }
}
