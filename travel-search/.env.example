# --- aggregators -------------------------------------------------------------
# Each provider is enabled by its own credentials. Configure at least one
# transport provider besides drive; the server refuses to start otherwise.

# Amadeus for Developers (flights + hotels). AMADEUS_ENV=production for live
# prices; "test" returns cached, partial data.
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_ENV=test

# Duffel (flights). Set DUFFEL_STAYS=on once Duffel has enabled Stays on the account.
DUFFEL_ACCESS_TOKEN=
DUFFEL_STAYS=off

# Kiwi.com Tequila (flights, trains and buses; powers "anywhere" and
# whole-date-window searches).
KIWI_API_KEY=

# Driving estimates (built in, no key): fuel cost per km and the longest drive
# offered, one way.
DRIVE_FUEL_GBP_PER_KM=0.13
DRIVE_MAX_KM=1500

# Which providers to use, comma separated. Defaults to amadeus,duffel,kiwi,drive
# (each only if its credentials are set). "mock" is for development and tests,
# and is refused when NODE_ENV=production.
TRAVEL_PROVIDERS=

# --- search tuning --------------------------------------------------------------
# Destinations considered on an open search (no destination given).
TRAVEL_OPEN_CANDIDATES=8
# Per-call timeout for each aggregator, in milliseconds.
TRAVEL_PROVIDER_TIMEOUT_MS=20000
# Currency rates per 1 GBP, overriding the built-in fallback table, e.g. {"USD":1.27,"EUR":1.16}
FX_RATES_JSON=

# --- storage --------------------------------------------------------------------
# file (default; JSON documents under TRAVEL_DATA_DIR) or memory.
TRAVEL_STORE=file
TRAVEL_DATA_DIR=.data

# --- HTTP -----------------------------------------------------------------------
PORT=3002
# The front end's origin, if it is served from somewhere else.
CORS_ORIGIN=
TRUST_PROXY_HOPS=1
RATE_LIMIT_SEARCH_PER_10_MIN=30
RATE_LIMIT_API_PER_10_MIN=300
