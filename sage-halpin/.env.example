# AI provider: foundry (production, Claude on Microsoft Foundry),
# anthropic (local development, Claude API) or mock (tests and offline demos;
# refused when NODE_ENV=production).
AI_PROVIDER=foundry
# AI_MODEL=claude-opus-5-5

# Claude on Microsoft Foundry. Set the resource name (or the full base URL).
# With no API key the app authenticates with Microsoft Entra ID
# (DefaultAzureCredential: managed identity in Azure, `az login` locally).
ANTHROPIC_FOUNDRY_RESOURCE=
# ANTHROPIC_FOUNDRY_BASE_URL=
# ANTHROPIC_FOUNDRY_API_KEY=

# Claude API, for AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=

# Public AI endpoint limits per client IP, per 10 minutes (per replica)
# RATE_LIMIT_CHAT_PER_10_MIN=20
# RATE_LIMIT_ANALYSIS_PER_10_MIN=10

# Build-time: address for the bespoke-challenge waitlist link (hidden if unset)
# VITE_ENQUIRY_EMAIL=

# Board questions (consultations): where the questions, invitations and answers
# are kept. memory (development; lost on restart) or table (Azure Table Storage,
# reached with Microsoft Entra ID). Production defaults to table.
# STORE=memory
# TABLE_ENDPOINT=https://<account>.table.core.windows.net
# TABLE_NAME=consultations
# CONSULTATION_RETENTION_DAYS=90

# Questionnaire email. manual (default): the lead sends each person their link
# from their own mailbox. acs: Azure Communication Services emails each person.
# EMAIL_PROVIDER=manual
# ACS_ENDPOINT=https://<name>.<region>.communication.azure.com
# EMAIL_SENDER=DoNotReply@mail.sentinel8.ai
# Public address used in emailed links (required for EMAIL_PROVIDER=acs)
# PUBLIC_BASE_URL=https://app.sentinel8.ai

# Limits per client IP, per 10 minutes (per replica)
# RATE_LIMIT_CONSULT_AI_PER_10_MIN=20
# RATE_LIMIT_CONSULT_PER_10_MIN=120
# RATE_LIMIT_RESPOND_PER_10_MIN=60

# Horizon scanning (keeps looking outward). Runs on a timer in the server.
# HORIZON_SCANNER=on
# Web search through Claude: web_search_20250305 works on Foundry hosted on
# Azure; web_search_20260209 needs the Claude API or Foundry hosted on Anthropic.
# WEB_SEARCH=on
# WEB_SEARCH_TOOL=web_search_20250305
