# --- credential vault --------------------------------------------------------
# Required before any third-party connector can be configured. 32 bytes, base64
# or hex. Without it the platform refuses to store credentials rather than
# writing them in plaintext.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
METAMSP_SECRET_KEY=

# --- seeding -----------------------------------------------------------------
# Optional. When unset, `npm run seed` generates passwords and prints them once.
METAMSP_ADMIN_PASSWORD=
METAMSP_USER_PASSWORD=
METAMSP_VIEWER_PASSWORD=

# --- single sign-on (optional) -----------------------------------------------
# All four are required together. Absent, the sign-in screen offers local
# passwords only and says SSO is not configured.
METAMSP_OIDC_ISSUER=
METAMSP_OIDC_CLIENT_ID=
METAMSP_OIDC_CLIENT_SECRET=
METAMSP_OIDC_REDIRECT_URI=
METAMSP_OIDC_NAME=
# Just-in-time provisioning is OFF unless a tenant is named here. Leaving it
# blank means an SSO user must already have an account.
METAMSP_OIDC_JIT_TENANT=
METAMSP_OIDC_JIT_ROLE=READ_ONLY

# Used for absolute redirects behind a proxy.
METAMSP_BASE_URL=

# --- optional data sources ---------------------------------------------------
COMPANIES_HOUSE_API_KEY=

# Microsoft 365, Xero and HubSpot are connected per tenant through the
# Integrations screen, not through this file.

# --- runtime -----------------------------------------------------------------
# SQLite location. Defaults to .data/metamsp.db
METAMSP_DB_PATH=
# Set to 1 to run without the background job worker (tests, one-off scripts).
METAMSP_DISABLE_WORKER=
