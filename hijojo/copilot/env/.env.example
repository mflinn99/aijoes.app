# Values substituted into the Copilot app package by `npm run copilot:package`.
# Copy to env/.env.prod (git-ignored) and fill in.

# A GUID you generate once and keep (it identifies the app in your tenant).
TEAMS_APP_ID=
AGENT_VERSION=1.0.0
# The public address of the Hijojo Container App, no trailing slash.
HIJOJO_API_URL=https://ca-hijojo-prod.example.uksouth.azurecontainerapps.io
# From Teams developer portal > Tools > Microsoft Entra SSO client ID registration.
HIJOJO_SSO_AUTH_CONFIG_ID=
SUPPORT_EMAIL=
PRIVACY_URL=
TERMS_URL=
