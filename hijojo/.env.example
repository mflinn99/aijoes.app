# Hijojo configuration. Set these in the deployment environment, never in source.

# --- sending ---------------------------------------------------------------
# "simulate" (default) records messages in a simulated outbox and sends nothing.
# "live" also requires Outlook below AND an administrator switching live
# sending on in Settings.
HIJOJO_SEND_MODE=simulate
# Positive, interested and referral responses are handed to this address.
HIJOJO_HANDOFF_TO=mark@aigogo.ai
# Name used to sign introductions.
HIJOJO_SENDER_NAME=
HIJOJO_DAILY_SEND_CAP=20

# --- AI provider (analysis, research, drafting, QA review) -----------------
ANTHROPIC_API_KEY=
# HIJOJO_MODEL=claude-opus-5-5
# Set to 0 to run QA on rules alone, without the second model reviewer.
# HIJOJO_MODEL_REVIEW=1

# --- Outlook via Microsoft Graph (see docs/OUTLOOK.md) ---------------------
HIJOJO_GRAPH_TENANT_ID=
HIJOJO_GRAPH_CLIENT_ID=
HIJOJO_GRAPH_CLIENT_SECRET=
HIJOJO_SENDER_MAILBOX=
HIJOJO_INBOX_POLL_MINUTES=5

# --- runtime -----------------------------------------------------------------
HIJOJO_DB_PATH=.data/hijojo.db
PORT=5050
# Users created by `npm run seed`; passwords are generated and printed once
# unless set here.
HIJOJO_ADMIN_EMAIL=
HIJOJO_ADMIN_PASSWORD=
